# ===================================================
# ✅ Inclusive Health Match — EAS Ignore Configuration
# Ensures iOS build files + vendored pods are included
# ===================================================

# Ignore build artifacts and logs
android/**
.expo/**
*.log
*.bak

# ✅ DO NOT exclude entire ios directory (critical!)
# ios/**   ← remove or comment out this line if present

# ✅ Explicitly include vendored pod + podspec files
!ios/ReactAppDependencyProvider/**
!ios/ReactAppDependencyProvider.podspec
!**/*.podspec

# Keep Podfile & Xcode projects
!ios/Podfile
!ios/Podfile.lock
!ios/InclusiveHealthMatch.xcodeproj/**
!ios/InclusiveHealthMatch.xcworkspace/**
