{
  "expo": {
    "name": "Inclusive Health Match",
    "slug": "inclusive-health-match",
    "owner": "whitecoat25",
    "version": "1.0.23",
    "orientation": "portrait",
    "scheme": "inclusivehealthmatch",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",

    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#10B981"
    },

    "assetBundlePatterns": ["**/*"],
    "platforms": ["ios", "android"],

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.audreydurrant.inclusivehealthmatch",
      "buildNumber": "6",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "We use your photo library to allow you to upload a profile picture for your provider or patient account.",
        "NSCameraUsageDescription": "We use your camera to take a profile photo directly within the app.",
        "NSUserTrackingUsageDescription": "We use your device's advertising identifier (IDFA) to measure app performance, attribute subscriptions, and improve user experience through analytics.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "supabase.co": {
              "NSIncludesSubdomains": true,
              "NSExceptionAllowsInsecureHTTPLoads": false,
              "NSExceptionRequiresForwardSecrecy": false,
              "NSRequiresCertificateTransparency": false
            }
          }
        }
      },
      "config": { "usesNonExemptEncryption": false }
    },

    "android": {
      "package": "com.audreydurrant.inclusivehealthmatch",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#10B981"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET"
      ]
    },

    "web": { "favicon": "./assets/favicon.png" },

    "runtimeVersion": "1.0.0",

    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
